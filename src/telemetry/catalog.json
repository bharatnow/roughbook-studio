{
  "version": 1,
  "events": {
    "studio.started": {
      "description": "The studio's local UI started, with the agents and editors it found.",
      "sentBy": "studio",
      "props": {
        "studioVersion": {
          "kind": "token"
        },
        "os": {
          "kind": "enum",
          "values": [
            "windows",
            "macos",
            "linux",
            "other"
          ]
        },
        "agents": {
          "kind": "list",
          "max": 20,
          "of": {
            "kind": "record",
            "props": {
              "id": {
                "kind": "enum",
                "values": [
                  "claude-code",
                  "codex",
                  "gemini-cli",
                  "antigravity-cli",
                  "cursor-cli",
                  "cursor",
                  "vscode",
                  "antigravity",
                  "windsurf",
                  "other"
                ]
              },
              "version": {
                "kind": "token",
                "nullable": true
              }
            }
          }
        }
      }
    },
    "project.created": {
      "description": "A project was created.",
      "sentBy": "server",
      "props": {
        "projectId": {
          "kind": "id"
        }
      }
    },
    "component.created": {
      "description": "A component was added to a page.",
      "sentBy": "server",
      "props": {
        "projectId": {
          "kind": "id"
        },
        "componentId": {
          "kind": "id"
        }
      }
    },
    "copy.drafted": {
      "description": "Copy versions were drafted, and by what.",
      "sentBy": "server",
      "props": {
        "path": {
          "kind": "enum",
          "values": [
            "assistant",
            "coding-agent"
          ]
        },
        "versions": {
          "kind": "int",
          "min": 1,
          "max": 50
        }
      }
    },
    "copy.approved": {
      "description": "A component's copy got a newly approved version, out of how many.",
      "sentBy": "server",
      "props": {
        "versions": {
          "kind": "int",
          "min": 1,
          "max": 999
        }
      }
    },
    "run.started": {
      "description": "A generation, fork or refinement started: where, with which agent and how many.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local"
          ]
        },
        "kind": {
          "kind": "enum",
          "values": [
            "generate",
            "refine",
            "fork",
            "critique",
            "promote",
            "pull"
          ]
        },
        "agent": {
          "kind": "enum",
          "values": [
            "claude-code",
            "codex",
            "gemini-cli",
            "antigravity-cli",
            "cursor-cli",
            "cursor",
            "vscode",
            "antigravity",
            "windsurf",
            "other",
            "api"
          ]
        },
        "mode": {
          "kind": "enum",
          "values": [
            "server",
            "interactive",
            "headless",
            "editor"
          ]
        },
        "model": {
          "kind": "token",
          "nullable": true
        },
        "directions": {
          "kind": "int",
          "min": 1,
          "max": 8
        }
      }
    },
    "run.finished": {
      "description": "A run ended: its setup, how long it took, how it went, its warnings and its writes outside its folder, by count.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local"
          ]
        },
        "kind": {
          "kind": "enum",
          "values": [
            "generate",
            "refine",
            "fork",
            "critique",
            "promote",
            "pull"
          ]
        },
        "agent": {
          "kind": "enum",
          "values": [
            "claude-code",
            "codex",
            "gemini-cli",
            "antigravity-cli",
            "cursor-cli",
            "cursor",
            "vscode",
            "antigravity",
            "windsurf",
            "other",
            "api"
          ]
        },
        "mode": {
          "kind": "enum",
          "values": [
            "server",
            "interactive",
            "headless",
            "editor"
          ]
        },
        "model": {
          "kind": "token",
          "nullable": true
        },
        "directions": {
          "kind": "int",
          "min": 1,
          "max": 8
        },
        "durationSeconds": {
          "kind": "int",
          "min": 0,
          "max": 86400,
          "nullable": true
        },
        "outcome": {
          "kind": "enum",
          "values": [
            "completed",
            "completed_with_warnings",
            "failed",
            "cancelled"
          ]
        },
        "warnings": {
          "kind": "int",
          "min": 0,
          "max": 100
        },
        "outOfScopeWrites": {
          "kind": "int",
          "min": 0,
          "max": 10000
        }
      }
    },
    "iteration.rated": {
      "description": "An iteration was rated, from 1 to 5, and how long after it was made: with the stack tokens of the repo it was made in, and whether it is a web sketch copied or ported into that repo, so ratings compare by stack.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local",
            "app"
          ]
        },
        "rating": {
          "kind": "int",
          "min": 1,
          "max": 5
        },
        "ageSeconds": {
          "kind": "int",
          "min": 0,
          "max": 315360000
        },
        "stack": {
          "kind": "list",
          "of": {
            "kind": "token"
          },
          "max": 12
        },
        "pulled": {
          "kind": "enum",
          "values": [
            "copy",
            "port"
          ],
          "nullable": true
        }
      }
    },
    "iteration.selected": {
      "description": "An iteration was selected, and how long after it was made.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local",
            "app"
          ]
        },
        "ageSeconds": {
          "kind": "int",
          "min": 0,
          "max": 315360000
        }
      }
    },
    "iteration.rejected": {
      "description": "An iteration was rejected: the preset reason's code, never the words, and how long after it was made.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local",
            "app"
          ]
        },
        "reason": {
          "kind": "enum",
          "values": [
            "too-generic",
            "weak-hierarchy",
            "wrong-media",
            "too-dense",
            "too-conventional",
            "poor-brand-fit",
            "custom"
          ]
        },
        "ageSeconds": {
          "kind": "int",
          "min": 0,
          "max": 315360000
        }
      }
    },
    "sketch.pulled": {
      "description": "A web sketch was pulled into a repo as a local iteration: its files copied as they are, or ported into the repo's stack by an agent.",
      "sentBy": "server",
      "props": {
        "sketchId": {
          "kind": "id"
        },
        "iterationId": {
          "kind": "id"
        },
        "how": {
          "kind": "enum",
          "values": [
            "copy",
            "port"
          ]
        }
      }
    },
    "repo.prepared": {
      "description": "A repo was linked to a project: its framework, its stack tokens, the family of checks, the preview mode, and whether rough/ is committed.",
      "sentBy": "server",
      "props": {
        "framework": {
          "kind": "token",
          "nullable": true
        },
        "roughCommitted": {
          "kind": "boolean"
        },
        "stack": {
          "kind": "list",
          "of": {
            "kind": "token"
          },
          "max": 12
        },
        "family": {
          "kind": "enum",
          "values": [
            "markup-css",
            "react-like",
            "flutter",
            "swiftui",
            "compose",
            "unknown"
          ],
          "nullable": true
        },
        "mode": {
          "kind": "enum",
          "values": [
            "live",
            "snapshot",
            "standalone"
          ],
          "nullable": true
        }
      }
    },
    "doctor.ran": {
      "description": "roughbook doctor ran on a linked repo: how it went, the preview mode, the family of checks, the stack tokens, the ids of the checks that failed, and the recipe that set the repo up (null for a setup an agent built with no recipe, or from a studio that does not say); when the run ended a setup run, whether that was roughbook setup or setup --fix and how many seconds it took from its start, both null otherwise.",
      "sentBy": "server",
      "props": {
        "outcome": {
          "kind": "enum",
          "values": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "mode": {
          "kind": "enum",
          "values": [
            "live",
            "snapshot",
            "standalone"
          ]
        },
        "family": {
          "kind": "enum",
          "values": [
            "markup-css",
            "react-like",
            "flutter",
            "swiftui",
            "compose",
            "unknown"
          ]
        },
        "stack": {
          "kind": "list",
          "of": {
            "kind": "token"
          },
          "max": 12
        },
        "failed": {
          "kind": "list",
          "of": {
            "kind": "token"
          },
          "max": 16
        },
        "recipe": {
          "kind": "token",
          "nullable": true
        },
        "setup": {
          "kind": "enum",
          "values": [
            "setup",
            "fix"
          ],
          "nullable": true
        },
        "setupSeconds": {
          "kind": "int",
          "min": 0,
          "max": 2592000,
          "nullable": true
        }
      }
    },
    "iteration.promoted": {
      "description": "An iteration was handed to an agent to write the real component, with the repo's framework.",
      "sentBy": "server",
      "props": {
        "origin": {
          "kind": "enum",
          "values": [
            "sketch",
            "local",
            "app"
          ]
        },
        "framework": {
          "kind": "token",
          "nullable": true
        },
        "roughCommitted": {
          "kind": "boolean",
          "nullable": true
        }
      }
    },
    "media.generated": {
      "description": "An image, video or 3D model was generated: which kind, provider, model and outcome.",
      "sentBy": "server",
      "props": {
        "kind": {
          "kind": "enum",
          "values": [
            "image",
            "video",
            "model3d"
          ]
        },
        "provider": {
          "kind": "token",
          "nullable": true
        },
        "model": {
          "kind": "token",
          "nullable": true
        },
        "outcome": {
          "kind": "enum",
          "values": [
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        }
      }
    },
    "map.ran": {
      "description": "roughbook map read a repo's pages and components: how many pages, components, missed and unplaced it listed, whether an agent's map run took part, and how long it took.",
      "sentBy": "studio",
      "props": {
        "pages": {
          "kind": "int",
          "min": 0,
          "max": 100000
        },
        "components": {
          "kind": "int",
          "min": 0,
          "max": 100000
        },
        "missed": {
          "kind": "int",
          "min": 0,
          "max": 100000
        },
        "unplaced": {
          "kind": "int",
          "min": 0,
          "max": 100000
        },
        "agent": {
          "kind": "boolean"
        },
        "milliseconds": {
          "kind": "int",
          "min": 0,
          "max": 86400000
        }
      }
    },
    "page.adopted": {
      "description": "A page the client's app has was adopted into a project, and how many of its components came with it.",
      "sentBy": "server",
      "props": {
        "components": {
          "kind": "int",
          "min": 0,
          "max": 500
        }
      }
    },
    "component.adopted": {
      "description": "A component the client's app has was adopted into a project: its kind.",
      "sentBy": "server",
      "props": {
        "kind": {
          "kind": "enum",
          "values": [
            "section",
            "shared",
            "atom"
          ]
        }
      }
    },
    "picture.uploaded": {
      "description": "A studio uploaded a picture: which one, whether of an iteration or of an adopted page, and the iteration’s origin (null for a page).",
      "sentBy": "server",
      "props": {
        "kind": {
          "kind": "enum",
          "values": [
            "thumbnail",
            "desktop",
            "phone"
          ]
        },
        "of": {
          "kind": "enum",
          "values": [
            "iteration",
            "page"
          ]
        },
        "origin": {
          "kind": "enum",
          "values": [
            "local",
            "app"
          ],
          "nullable": true
        }
      }
    },
    "error.reported": {
      "description": "Something failed in the studio: the error code and where, never the message.",
      "sentBy": "studio",
      "props": {
        "code": {
          "kind": "code"
        },
        "area": {
          "kind": "enum",
          "values": [
            "cli",
            "local-ui"
          ]
        }
      }
    }
  }
}
