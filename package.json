{
  "name": "roughbook",
  "version": "0.3.13",
  "private": false,
  "description": "Roughbook studio: design iterations inside your own repo, with the coding agent and editor you already use",
  "type": "module",
  "bin": {
    "roughbook": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"ui/src/**/*.test.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"ui/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"ui/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write . && eslint \"src/**/*.ts\" \"ui/**/*.{ts,tsx}\" --fix",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc --noEmit -p ui && tsc --noEmit -p ui/tsconfig.test.json",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "build:ui": "vite build --config ui/vite.config.ts",
    "quiet-budget": "tsx src/tests/quiet-budget.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bharatnow/roughbook-studio.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@roughbook/ui": "^0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
